PORT=3000
# OpenAI-compatible endpoint. Groq default:
BASE_URL=https://api.groq.com/openai/v1
# Model used as the code reviewer.
MODEL=llama-3.3-70b-versatile
# Required when BASE_URL points at Groq.
GROQ_API_KEY=
# Optional: GitHub token raises clone rate limits for public repos.
GITHUB_TOKEN=
# Max repo size in bytes accepted for git clone (default 20MB).
MAX_CLONE_BYTES=20000000
# Max uploaded zip size in bytes (default 25MB).
MAX_ZIP_BYTES=25000000